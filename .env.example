# Copy to .env and adjust for local development.
# Do not commit .env — it is gitignored (REQ-TECH-08).

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=support_tickets
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_PORT=5432

# --- Backend (Spring Boot local profile) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/support_tickets
SPRING_DATASOURCE_USERNAME=support
SPRING_DATASOURCE_PASSWORD=support

# --- Frontend (Next.js — when frontend/ exists) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
